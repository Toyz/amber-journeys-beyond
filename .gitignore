# Build output
/target

# Game data. The disc images and their contents are not redistributable and
# must be supplied by whoever runs this; see README.md.
#
# The Macintosh release is two HFS volumes inside StuffIt archives, unpacked
# to mac_iso/ and then merged into mac_game/ by tools/hfs.py.
/extract
/mac_iso
/mac_game
/mac_extract
*.iso
*.ISO
*.sit
*.zip

# Scratch
/tools/__pycache__

/playthrough

# Replay logs from `--log`, which are large and per-run.
*.walk.log

# Android build output. The disc is copied in by build.rs and is not ours to
# redistribute; the APK contains it.
/crates/android/assets
*.apk
*.aab

# APK signing artefacts. The keystore is a key and the idsig is build output.
/crates/android/debug.keystore
*.idsig
