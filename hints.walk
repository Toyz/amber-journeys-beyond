state baronline
# The PeeK unit flashes: pick it out of the bar and it reports the BAR running.
inv 320 410
click 320 200
state pkbarstatus
# The unit stays in the hand until it is put back, so put it back.
click 320 200
# The mailbox on the porch: open it, take the box, read the label and the
# letter, and the oscillator is underneath.
PorchMailboxCU
click 350 200
click 350 250
examine
pointer
